set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR x86_64)
set(CMAKE_C_COMPILER x86_64-w64-mingw32-gcc)
set(CMAKE_CXX_COMPILER x86_64-w64-mingw32-g++)
set(CMAKE_RC_COMPILER x86_64-w64-mingw32-windres)
set(QT_HOST_PATH /usr CACHE PATH "宿主 Qt（提供 Linux 版 moc/uic/rcc）")
set(CMAKE_FIND_ROOT_PATH /root/workspace/.local/Qt/6.4.2/mingw_64 /root/workspace/.local/openssl-mingw /root/workspace/.local/bullet-mingw /root/workspace/.local/lua-mingw /usr/x86_64-w64-mingw32)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_AUTOMOC_EXECUTABLE /usr/lib/qt6/libexec/moc CACHE FILEPATH "host moc")
set(CMAKE_AUTORCC_EXECUTABLE /usr/lib/qt6/libexec/rcc CACHE FILEPATH "host rcc")
set(CMAKE_AUTOUIC_EXECUTABLE /usr/lib/qt6/libexec/uic CACHE FILEPATH "host uic")
